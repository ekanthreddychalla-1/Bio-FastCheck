{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PresignFastaUploads",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::biofastcheck-raw-data/*"
    },
    {
      "Sid": "ReadBioFastCheckResults",
      "Effect": "Allow",
      "Action": ["dynamodb:Scan"],
      "Resource": "arn:aws:dynamodb:eu-north-1:477213278851:table/BioFastCheckResults"
    }
  ]
}
